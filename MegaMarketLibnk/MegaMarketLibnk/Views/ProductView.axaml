<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:MegaMarketLibnk.ViewModels"
             mc:Ignorable="d" d:DesignWidth="1400" d:DesignHeight="800"
             x:Class="MegaMarketLibnk.Views.ProductView"
             x:DataType="vm:ProductViewModel">
    <UserControl.Styles>
        <Style Selector="Button.tab">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#B9B9C3" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="16,8" />
        </Style>
        <Style Selector="Button.tab.selected">
            <Setter Property="Background" Value="#5B4FE0" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="Button.gallery">
            <Setter Property="Background" Value="#99000000" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="CornerRadius" Value="18" />
            <Setter Property="Width" Value="36" />
            <Setter Property="Height" Value="36" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="12,0" />
        </Style>
        <Style Selector="Button.thumb">
            <Setter Property="Padding" Value="0" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Width" Value="56" />
            <Setter Property="Height" Value="56" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
    </UserControl.Styles>
    <Grid RowDefinitions="Auto,*" Background="#141417">
        <Border Grid.Row="0" Background="#1F1F24" Padding="24,12">
            <StackPanel Orientation="Horizontal" Spacing="16">
                <Button Classes="secondary" Content="← Назад к товарам" Command="{Binding BackCommand}" />
                <Button Classes="secondary" Content="Корзина" Command="{Binding OpenCartCommand}" />
                <TextBlock Text="MegaMarket" FontSize="21" FontWeight="Bold"
                           Foreground="White" VerticalAlignment="Center" />
            </StackPanel>
        </Border>
        <Grid Grid.Row="1" ColumnDefinitions="5*,6*" ColumnSpacing="28" Margin="28,24">
            <StackPanel Grid.Column="0" Spacing="12">
                <Grid Height="380">
                    <Border Background="{Binding CurrentColor}" CornerRadius="20" />
                    <Button Classes="gallery" Content="◀" Command="{Binding PrevImageCommand}"
                            HorizontalAlignment="Left" VerticalAlignment="Center" />
                    <Button Classes="gallery" Content="▶" Command="{Binding NextImageCommand}"
                            HorizontalAlignment="Right" VerticalAlignment="Center" />
                    <Border Background="#99000000" CornerRadius="10" Padding="10,4"
                            HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,12">
                        <TextBlock Text="{Binding ImageCounterText}" Foreground="White" FontSize="13" />
                    </Border>
                </Grid>
                <ItemsControl ItemsSource="{Binding Gallery}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" Spacing="8" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Classes="thumb" Background="{Binding Color}"
                                    Command="{Binding $parent[UserControl].((vm:ProductViewModel)DataContext).SelectImageCommand}"
                                    CommandParameter="{Binding Index}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
            <ScrollViewer Grid.Column="1">
                <StackPanel Spacing="14">
                    <TextBlock Text="{Binding CategoryName}" Foreground="#FFD166" FontSize="14" />
                    <TextBlock Text="{Binding Title}" Foreground="White" FontSize="24"
                               FontWeight="Bold" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding RatingText}" Foreground="#FFD166" FontSize="14"
                               IsVisible="{Binding HasRating}" />
                    <TextBlock Text="{Binding SellerName}" Foreground="#B9B9C3" FontSize="15" />
                    <Border Background="#1F1F24" CornerRadius="14" Padding="20">
                        <StackPanel Spacing="12">
                            <TextBlock Text="{Binding PriceText}" Foreground="White"
                                       FontSize="34" FontWeight="Bold" />
                            <Button Classes="primary" Content="Добавить в корзину"
                                    Command="{Binding AddToCartCommand}"
                                    HorizontalAlignment="Stretch" Padding="0,12" />
                            <TextBlock Text="{Binding Status}" Foreground="#4ADE80" FontSize="14" />
                        </StackPanel>
                    </Border>
                    <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,6,0,0">
                        <Button Classes="tab" Content="Описание"
                                Classes.selected="{Binding IsDescriptionTab}"
                                Command="{Binding SelectTabCommand}" CommandParameter="0" />
                        <Button Classes="tab" Content="Характеристики"
                                Classes.selected="{Binding IsCharacteristicsTab}"
                                Command="{Binding SelectTabCommand}" CommandParameter="1" />
                        <Button Classes="tab" Content="{Binding ReviewsTabText}"
                                Classes.selected="{Binding IsReviewsTab}"
                                Command="{Binding SelectTabCommand}" CommandParameter="2" />
                    </StackPanel>
                    <Border Background="#1F1F24" CornerRadius="14" Padding="20">
                        <Grid>
                            <TextBlock IsVisible="{Binding IsDescriptionTab}"
                                       Text="{Binding Description}" Foreground="#D6D6DE"
                                       FontSize="16" TextWrapping="Wrap" />
                            <StackPanel IsVisible="{Binding IsCharacteristicsTab}">
                                <TextBlock IsVisible="{Binding !HasCharacteristics}"
                                           Text="Характеристики пока не добавлены."
                                           Foreground="#80808C" FontSize="15" />
                                <ItemsControl ItemsSource="{Binding Characteristics}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid ColumnDefinitions="*,*" Margin="0,5">
                                                <TextBlock Text="{Binding Key}" Foreground="#B9B9C3" FontSize="15" />
                                                <TextBlock Grid.Column="1" Text="{Binding Value}"
                                                           Foreground="White" FontSize="15" TextWrapping="Wrap" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                            <StackPanel IsVisible="{Binding IsReviewsTab}">
                                <TextBlock IsVisible="{Binding !HasReviews}"
                                           Text="Пока нет отзывов — станьте первым!"
                                           Foreground="#80808C" FontSize="15" />
                                <ScrollViewer MaxHeight="380">
                                    <ItemsControl ItemsSource="{Binding Reviews}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="#26262E" CornerRadius="10"
                                                        Padding="14" Margin="0,0,0,10">
                                                    <StackPanel Spacing="4">
                                                        <Grid ColumnDefinitions="*,Auto">
                                                            <TextBlock Text="{Binding Author}" Foreground="White"
                                                                       FontWeight="SemiBold" />
                                                            <TextBlock Grid.Column="1" Text="{Binding Stars}"
                                                                       Foreground="#FFD166" />
                                                        </Grid>
                                                        <TextBlock Text="{Binding Date}" FontSize="12"
                                                                   Foreground="#80808C" />
                                                        <TextBlock Text="{Binding Text}" TextWrapping="Wrap"
                                                                   Foreground="#D6D6DE" FontSize="14" />
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </StackPanel>
                        </Grid>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
