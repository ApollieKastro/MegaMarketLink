<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:MegaMarketLibnk.ViewModels"
             xmlns:models="using:MegaMarketLibnk.Models"
             mc:Ignorable="d" d:DesignWidth="1600" d:DesignHeight="900"
             x:Class="MegaMarketLibnk.Views.HomeView"
             x:DataType="vm:HomeViewModel">
    <Design.DataContext>
        <vm:HomeViewModel />
    </Design.DataContext>
    <UserControl.Styles>
        <Style Selector="Button.tile">
            <Setter Property="Width" Value="212" />
            <Setter Property="Margin" Value="0,0,14,14" />
            <Setter Property="Background" Value="#1F1F24" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
        </Style>
        <Style Selector="Button.tile:hover">
            <Setter Property="Background" Value="#26262E" />
        </Style>
    </UserControl.Styles>
    <UserControl.DataTemplates>
        <DataTemplate DataType="{x:Type models:ProductTile}" x:CompileBindings="False">
            <Button Classes="tile"
                    Command="{Binding $parent[UserControl].DataContext.OpenProductCommand}"
                    CommandParameter="{Binding}">
                <StackPanel>
                    <Border Height="150" CornerRadius="12,12,0,0" Background="{Binding Color}" />
                    <StackPanel Spacing="8" Margin="12,10,12,14">
                        <TextBlock Text="{Binding Title}" Foreground="#E9E9F1" FontSize="14"
                                   TextWrapping="Wrap" MaxLines="2"
                                   TextTrimming="CharacterEllipsis" MinHeight="38" />
                        <TextBlock Text="{Binding PriceText}" Foreground="White"
                                   FontSize="19" FontWeight="Bold" />
                    </StackPanel>
                </StackPanel>
            </Button>
        </DataTemplate>
        <DataTemplate DataType="{x:Type models:SaleTile}" x:CompileBindings="False">
            <Button Classes="tile" Command="{Binding $parent[UserControl].DataContext.OpenProductCommand}"
                    CommandParameter="{Binding}">
                <StackPanel>
                    <Border Height="150" CornerRadius="12,12,0,0" Background="{Binding Color}">
                        <Border Background="#FF3B30" CornerRadius="6" Padding="8,3"
                                HorizontalAlignment="Left" VerticalAlignment="Top" Margin="8">
                            <TextBlock Text="{Binding Badge}" Foreground="White"
                                       FontWeight="Bold" FontSize="12" />
                        </Border>
                    </Border>
                    <StackPanel Spacing="8" Margin="12,10,12,14">
                        <TextBlock Text="{Binding Title}" Foreground="#E9E9F1" FontSize="14"
                                   TextWrapping="Wrap" MaxLines="2"
                                   TextTrimming="CharacterEllipsis" MinHeight="38" />
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <TextBlock Text="{Binding PriceText}" Foreground="#4ADE80"
                                       FontSize="19" FontWeight="Bold" />
                            <TextBlock Text="{Binding OldPriceText}" Foreground="#8A8A96"
                                       FontSize="14" TextDecorations="Strikethrough"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </Button>
        </DataTemplate>
    </UserControl.DataTemplates>
    <Grid RowDefinitions="Auto,*" Background="#141417">
        <Border Grid.Row="0" Background="#1F1F24" Padding="24,12">
            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="20">
                <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <Border Width="34" Height="34" CornerRadius="9" Background="#FF3B30">
                        <TextBlock Text="M" FontWeight="Bold" FontSize="19" Foreground="White"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="MegaMarket" FontSize="21" FontWeight="Bold"
                               Foreground="White" VerticalAlignment="Center" />
                    <ComboBox Margin="30,0,0,0" MinWidth="180" VerticalAlignment="Center"
                              ItemsSource="{Binding Categories}"
                              SelectedItem="{Binding SelectedCategory, Mode=TwoWay}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Name}" Foreground="#E4E4EC" FontSize="14" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </StackPanel>
                <TextBox Grid.Column="1" PlaceholderText="Найти товары"
                         Text="{Binding SearchText, Mode=TwoWay}"
                         Width="300" HorizontalAlignment="Center" VerticalAlignment="Center" />
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="18" VerticalAlignment="Center">
                    <Button Classes="secondary" Content="Заказы" Command="{Binding OpenCabinetCommand}" Padding="12,6" FontSize="13" VerticalAlignment="Center" />
                    <Button Classes="secondary" Content="Панель продавца" Command="{Binding OpenSellerCabinetCommand}" IsVisible="{Binding IsSeller}" Padding="12,6" FontSize="13" VerticalAlignment="Center" />
                    <Button Classes="secondary" Content="{Binding CartCountText}"
                            Command="{Binding OpenCartCommand}"
                            Padding="12,6" FontSize="13" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding UserName}" Foreground="#FFD166" FontSize="13"
                               VerticalAlignment="Center" />
                </StackPanel>
            </Grid>
        </Border>
        <Grid Grid.Row="1" ColumnDefinitions="250,*">
            <Border Grid.Column="0" Background="#1F1F24" CornerRadius="16" Margin="16,16,0,16" Padding="14">
                <ScrollViewer>
                    <StackPanel Spacing="6">
                        <TextBlock Text="Фильтры" FontWeight="Bold" FontSize="16"
                                   Foreground="White" Margin="8,4,8,6" />
                        <TextBlock Text="Цена, ₽" Foreground="#B9B9C3" FontSize="13" Margin="8,4,0,2" />
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                            <TextBox PlaceholderText="от" Text="{Binding PriceMin, Mode=TwoWay}" />
                            <TextBox Grid.Column="1" PlaceholderText="до" Text="{Binding PriceMax, Mode=TwoWay}" />
                        </Grid>
                        <TextBlock Text="Бренды" FontWeight="SemiBold" Foreground="White"
                                   FontSize="14" Margin="8,10,0,2" />
                        <ItemsControl ItemsSource="{Binding BrandFilters}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:FilterOption" x:CompileBindings="False">
                                    <CheckBox IsChecked="{Binding IsChecked, Mode=TwoWay}"
                                              Content="{Binding Name}"
                                              Foreground="#E4E4EC" FontSize="14" Margin="0,2" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="Параметры товара" FontWeight="SemiBold" Foreground="White"
                                   FontSize="14" Margin="8,10,0,2" />
                        <ItemsControl ItemsSource="{Binding ParamFilters}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:FilterOption" x:CompileBindings="False">
                                    <CheckBox IsChecked="{Binding IsChecked, Mode=TwoWay}"
                                              Content="{Binding Name}"
                                              Foreground="#E4E4EC" FontSize="14" Margin="0,2" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Button Classes="secondary" Content="Сбросить фильтры"
                                Command="{Binding ResetFiltersCommand}"
                                HorizontalAlignment="Stretch" Margin="8,12,8,4" />
                    </StackPanel>
                </ScrollViewer>
            </Border>
            <ScrollViewer Grid.Column="1" x:Name="FeedScroll"
                          VerticalScrollBarVisibility="Auto" Margin="16,16,16,0">
                <StackPanel Spacing="14">
                    <ItemsControl ItemsSource="{Binding Items}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                    <TextBlock Text="{Binding Status}" IsVisible="{Binding HasStatus}"
                               Foreground="#B9B9C3" FontSize="15"
                               HorizontalAlignment="Center" Margin="0,20,0,0" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="12"
                                Margin="0,6,0,24" IsVisible="{Binding IsLoading}">
                        <ProgressBar IsIndeterminate="True" Width="150" Height="6" VerticalAlignment="Center" />
                        <TextBlock Text="Загружаем товары…" Foreground="#B9B9C3" FontSize="14"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                    <StackPanel HorizontalAlignment="Center" Margin="0,4,0,28"
                                IsVisible="{Binding ShowMoreButton}">
                        <Button Classes="secondary" Content="Показать ещё"
                                Command="{Binding LoadMoreCommand}" />
                    </StackPanel>
                    <StackPanel HorizontalAlignment="Center" Margin="0,4,0,32"
                                IsVisible="{Binding EndOfList}">
                        <TextBlock Text="✓ Все товары показаны" Foreground="#7A7A86" FontSize="14" />
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
