<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:MegaMarketLibnk.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1166" d:DesignHeight="643"
        x:Class="MegaMarketLibnk.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Width="1920" Height="1080"
        MinWidth="900" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Title="MegaMarket — Регистрация">
    <Design.DataContext>
        <vm:MainWindowViewModel />
    </Design.DataContext>
    <Window.Background>
        <ImageBrush Source="/Assets/Backround.png" Stretch="Fill" />
    </Window.Background>
    <TransitioningContentControl Content="{Binding CurrentModel}"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Stretch" />
</Window>
